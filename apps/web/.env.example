# Server-only (never NEXT_PUBLIC_* for secrets or private API credentials).
# Local: copy to .env.local
# Vercel: vercel env add DESK_API_URL (Production/Preview) — Sensitive
# Central service. The browser never sees this; the BFF does.
DESK_CLOUD_URL=https://nebius-desk-cloud.devops-640.workers.dev
DESK_API_URL=http://127.0.0.1:8000

# Apex hostname. app.SITE_HOST serves /login and /dashboard.
# Every other hostname redirects to https://SITE_HOST/
# Leave empty on localhost and on *.vercel.app until the custom domain is attached.
SITE_HOST=
