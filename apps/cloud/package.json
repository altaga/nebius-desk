{
  "name": "@nebius-desk/cloud",
  "version": "0.1.0",
  "private": true,
  "description": "Nebius Desk central service: accounts, boards, plan, gateway, and the board relay",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply nebius-desk --local",
    "migrate:remote": "wrangler d1 migrations apply nebius-desk --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "wrangler": "^4.151.0"
  }
}
