# =============================================================================
# Nebius Desk — copy to secrets.env, fill, tell agent "listo".
# Agent must NEVER print secrets.env contents.
# =============================================================================

# Cloudflare API Token (Account → Cloudflare Tunnel → Edit) + Account ID
# Named tunnel → https://<id>.cfargotunnel.com (no custom DNS needed)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_TUNNEL_NAME=nebius-desk

# Vercel (web deploy) — create at vercel.com/account/tokens
# DESK_API_URL is synced to Vercel as Sensitive server env (NOT NEXT_PUBLIC).
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
# Optional override for what gets synced as DESK_API_URL (else .cf/public-url.txt)
DESK_API_URL=

# Nebius Token Factory
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL_FAST=nvidia/Nemotron-3_5-Lightning
NEBIUS_MODEL_BALANCED=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_MODEL_HEAVY=nvidia/nemotron-3-super-120b-a12b
NEBIUS_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# Auth (agent can generate JWT_SECRET / BOOTSTRAP_PASSWORD if empty)
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=

# Runtime
LLM_MODE=dummy
NEBIUS_DAILY_BUDGET_USD=2.00
NEBIUS_SESSION_TOKEN_CAP=50000
NEBIUS_USD_PER_1M_TOKENS=0.50
# Tavily lifetime cap. Do not raise this; the key only has 1500 credits.
TAVILY_API_KEY=
TAVILY_CREDIT_CAP=1500

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
DATABASE_URL=sqlite:///./data/nebiusdesk.db
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://127.0.0.1:3000
API_BIND_HOST=0.0.0.0
API_BIND_PORT=8000
