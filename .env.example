# Copy to apps/api/.env — NEVER commit real keys.
# Default keeps Nebius spend at $0.

# dummy | hybrid | cloud_only | local_only
LLM_MODE=dummy

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=changeme

# Nebius Token Factory (OpenAI-compatible). Dummy until you flip LLM_MODE.
NEBIUS_API_KEY=sk-nebius-dummy-do-not-use
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL_FAST=nvidia/Nemotron-3.5-Lightning
NEBIUS_MODEL_BALANCED=nvidia/Nemotron-3-Nano
NEBIUS_MODEL_HEAVY=nvidia/Nemotron-3-Super
NEBIUS_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# Soft caps (USD) — protect the $25 contest budget
NEBIUS_DAILY_BUDGET_USD=2.00
NEBIUS_SESSION_TOKEN_CAP=50000
NEBIUS_USD_PER_1M_TOKENS=0.50

# Local SLM (Ollama on Jetson later)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Tavily (optional — mock when empty). Lifetime cap; basic search = 1 credit.
TAVILY_API_KEY=
TAVILY_CREDIT_CAP=1500

# CORS for local web/mobile
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://127.0.0.1:3000

# SQLite path (relative to apps/api)
DATABASE_URL=sqlite:///./data/nebiusdesk.db
