{
  "name": "nebius-desk",
  "private": true,
  "version": "0.1.0",
  "description": "Nebius Desk — hybrid Jetson edge + Nebius Token Factory agent desk",
  "scripts": {
    "dev:api": "cd apps/api && python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "dev:web": "cd apps/web && npm run dev",
    "dev:mobile": "cd apps/mobile && npx expo start",
    "install:web": "cd apps/web && npm install",
    "install:mobile": "cd apps/mobile && npm install",
    "install:api": "cd apps/api && pip install -r requirements.txt"
  },
  "engines": {
    "node": ">=20"
  }
}
